PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Leave blank until a Supabase project exists.
# The service-role key bypasses Row Level Security. It must stay on the server.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend. The from address must use the verified domain.
RESEND_API_KEY=
RESEND_FROM=noreply@salonanan.com
